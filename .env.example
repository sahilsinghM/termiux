# Required: login password.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_TOKEN=change-me-use-a-long-random-string

# Required in production: separate secret for signing session cookies.
# Generate the same way as AUTH_TOKEN. Must be set and distinct from AUTH_TOKEN
# (startup fails otherwise, except in NODE_ENV=development).
SESSION_SECRET=change-me-use-a-different-random-string

# TLS (HTTPS). Both must be set together, or neither.
# Self-signed: openssl req -x509 -newkey rsa:4096 -keyout key.pem -out cert.pem -days 365 -nodes -subj "/CN=localhost"
# Let's Encrypt: point these at /etc/letsencrypt/live/<domain>/fullchain.pem and privkey.pem
TLS_CERT_FILE=/path/to/cert.pem
TLS_KEY_FILE=/path/to/key.pem

# Cloudflare Access JWT verification (from Zero Trust dashboard → Access → Applications → your app)
CF_TEAM_DOMAIN=https://<team>.cloudflareaccess.com
CF_AUD=<aud-from-access-app>

# Fail closed: if set truthy, startup aborts unless CF_TEAM_DOMAIN and CF_AUD
# are both configured — so the Access gate can never silently no-op.
REQUIRE_CF_ACCESS=true

# Authorization allow-list (comma-separated). Verified Access identities not on
# this list are rejected even with a valid JWT: user emails and/or service-token
# common_names. Empty = authenticate only (any valid JWT for CF_AUD passes).
CF_ALLOWED_EMAILS=me@example.com,agent-1.access

# Port the server listens on.
PORT=3000

# Set to "production" for the secure cookie flag (required when using HTTPS without a proxy).
NODE_ENV=production
