# Required: a long random string used as both the login password and session secret.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_TOKEN=change-me-use-a-long-random-string

# Port the server listens on. Caddy/nginx proxies HTTPS → this port.
PORT=3000

# Set to "production" when running behind HTTPS. Controls the cookie "secure" flag.
NODE_ENV=production
